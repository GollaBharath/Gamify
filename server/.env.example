### Gamify server .env example
# Copy this file to `.env` or set environment variables in your deployment

# General
PORT=5173
LOCAL_DEV=true
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/gamify

# Session
SESSION_SECRET=change_this_to_a_strong_secret

# JWT
JWT_EXPIRES_IN=1h

# CORS
# Comma separated allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5000

# OAuth (Google)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
PORT=5000
MONGO_URI=your_mongodb_uri
JWT_SECRET=your_jwt_secret
FRONTEND_URL=your_frontend_url
EMAIL_USERNAME=your_email
EMAIL_PASSWORD=your_password
# OAuth / session / app settings
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
JWT_EXPIRES_IN=7d
SESSION_SECRET=your_session_secret
CORS_ORIGINS=http://localhost:5173,http://localhost:5000

# Rate limiting for authentication endpoints
AUTH_LOGIN_MAX=10
AUTH_LOGIN_WINDOW_MS=900000
AUTH_REGISTER_MAX=5
DEFAULT_ORG_NAME=Gamify
BOOTSTRAP_ADMIN_EMAILS=admin@example.com