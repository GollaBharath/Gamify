### Gamify server .env example
# Copy this file to `.env` or set environment variables in your deployment

# General
PORT=5173
# Set to "true" during local development to enable local DB connection
LOCAL_DEV=true
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/gamify

# Session
SESSION_SECRET=change_this_to_a_strong_secret

# JWT
JWT_EXPIRES_IN=1h

# CORS (comma separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:5000

# OAuth (Google)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Optional application settings
FRONTEND_URL=http://localhost:5173
EMAIL_USERNAME=your_email@example.com
EMAIL_PASSWORD=your_email_password

# Rate limiting for authentication endpoints
AUTH_LOGIN_MAX=10
AUTH_LOGIN_WINDOW_MS=900000
AUTH_REGISTER_MAX=5

DEFAULT_ORG_NAME=Gamify
BOOTSTRAP_ADMIN_EMAILS=admin@example.com